# nginx site for the board -- a TEMPLATE: setup-root.sh renders it into nginx.conf (not in git) with
# @BOARD_DOMAIN@ (the host of PUBLIC_ORIGIN in .env), @UI_PORT@ and @API_PORT@ (UI_PORT / POSTGRESTPORT)
# filled in, and symlinks /etc/nginx/sites-enabled/board to it. TLS terminates here with one Let's
# Encrypt cert for all three names (issued by setup-root.sh). server_name-scoped: it only matches the
# board's own hostnames, so it cannot affect other sites on the host.

# HTML documents must NOT be browser-cached: the UI is the live vite dev server.
map $sent_http_content_type $board_cc {
    default        "";
    "~*text/html"  "no-store";
}

# :80 -> https for all names (certbot renewals use the --nginx authenticator, which injects its own
# challenge location, so a blanket redirect is fine)
server {
    listen 80;
    listen [::]:80;
    server_name @BOARD_DOMAIN@ www.@BOARD_DOMAIN@ api.@BOARD_DOMAIN@;
    location / { return 301 https://$host$request_uri; }
}

# www. -> apex
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name www.@BOARD_DOMAIN@;
    ssl_certificate     /etc/letsencrypt/live/@BOARD_DOMAIN@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@BOARD_DOMAIN@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    return 301 https://@BOARD_DOMAIN@$request_uri;
}

# @BOARD_DOMAIN@ -> SvelteKit (vite dev, user process on UI_PORT; see tmux.sh WORKERS[ui])
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name @BOARD_DOMAIN@;
    ssl_certificate     /etc/letsencrypt/live/@BOARD_DOMAIN@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@BOARD_DOMAIN@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    # doc:vite-hardening R5 (#222): dotfiles, vite internals outside web/ + claude-ui/, ?raw/?inline tricks
    location ~ /\.(?!well-known/|svelte-kit/|vite/) { return 404; }
    location ~ ^/@fs/(?!home/[^/]+/(web|claude-ui)/) { return 403; }
    location ~ ^/(__open-in-editor|__inspect|node_modules/\.vite/deps/.*\.map$) { return 403; }
    if ($args ~* "(^|&)(raw|inline)(&|=|$)|\?\?|%3f%3f") { return 403; }
    location / {
        proxy_pass http://127.0.0.1:@UI_PORT@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;          # Vite HMR websocket
        proxy_set_header Connection $http_connection;
        add_header Cache-Control $board_cc always;
    }
}

# api.@BOARD_DOMAIN@ -> PostgREST (user process on POSTGRESTPORT)
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name api.@BOARD_DOMAIN@;
    ssl_certificate     /etc/letsencrypt/live/@BOARD_DOMAIN@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@BOARD_DOMAIN@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 2M;             # messages are text; api.post caps the body at 64KB anyway
    location / {
        proxy_pass http://127.0.0.1:@API_PORT@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
