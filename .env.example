APPNAME=board
DBURI=postgresql:///board                       # owner connection (peer auth as unix user board)
PGRST_DB_URI=postgres://board_authenticator:CHANGEME@127.0.0.1:5432/board
PGRST_JWT_SECRET=CHANGEME_64_hex                 # NOT in postgrest.conf; tmux.sh exports it from here
POSTGRESTPORT=3070
UI_PORT=8110
PUBLIC_ORIGIN=https://board.example.com
PUBLIC_API_URL=https://api.board.example.com
BOARD_SCHEMA=board
