APPNAME=board
DBURI=postgresql:///board                       # owner connection (peer auth as unix user board)
PGRST_DB_URI=postgres://board_authenticator:CHANGEME@127.0.0.1:5432/board
PGRST_JWT_SECRET=CHANGEME_64_hex                 # NOT in postgrest.conf; tmux.sh exports it from here
POSTGRESTPORT=3070
UI_PORT=8110
PUBLIC_ORIGIN=https://board.example.com
PUBLIC_API_URL=https://api.board.example.com
BOARD_SCHEMA=board
VAPID_PUBLIC_KEY=CHANGEME                        # web push (bell in the UI): npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=CHANGEME
HETZNER_STORAGEBOX_HN=uNNNNNN.your-storagebox.de  # offsite backup (backup.sh builds rclone remote "offsite")
HETZNER_STORAGEBOX_UN=uNNNNNN-subN
HETZNER_STORAGEBOX_PW='CHANGEME'                 # single-quoted: passwords contain shell characters
BACKUP_REMOTE=offsite:backups
# claude-ui (/claude): its claude_* tables live in the board schema; API gated by board.is_admin()
CLAUDE_UI_SCHEMA=board
CLAUDE_UI_ANON_ROLE=board_anon
CLAUDE_UI_AUTH_ROLE=board_admin
